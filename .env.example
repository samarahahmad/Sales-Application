# --- Server ---
PORT=3000
# Optional shared code the sales team types once on their phone.
# Leave empty for an internal network deployment.
TEAM_ACCESS_CODE=
MAX_UPLOAD_MB=15
MAX_FILES=10

# --- E-mail (Office 365 example) ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales-app@watersecret.com.sa
SMTP_PASS=
MAIL_FROM="Water Secret Sales App <sales-app@watersecret.com.sa>"
# Reply goes back to the sales rep who registered the opportunity
MAIL_REPLY_TO_SALES=true
# Copy the sales rep on every registration
MAIL_CC_SALES=true

# Fallback recipients if config/recipients.json is missing
DEFAULT_RECIPIENTS=engineering@watersecret.com.sa
